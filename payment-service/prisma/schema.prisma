// Modelo de dados do serviço de pagamento (banco "payment", só deste serviço).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Estados da transação pedidos pelo enunciado: pendente -> sucesso
enum TransactionStatus {
  PENDING
  SUCCESS
}

model Transaction {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id")
  userEmail String            @map("user_email")
  orderId   String            @map("order_id")
  // Decimal, e não float: valores em dinheiro não podem ter erro de arredondamento
  amount    Decimal           @db.Decimal(12, 2)
  status    TransactionStatus @default(PENDING)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@map("transactions")
}
