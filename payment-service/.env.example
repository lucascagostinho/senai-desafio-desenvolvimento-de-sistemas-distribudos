# Copie para .env e use as senhas do .env da raiz do repositório.
# Use 127.0.0.1 (e não localhost): o docker-compose só expõe as portas em IPv4.

# Porta HTTP do serviço
PORT=3000

# Banco do pagamento (usuário PAYMENT_DB_USER / PAYMENT_DB_PASSWORD da raiz)
DATABASE_URL="postgresql://payment_service:change-me@127.0.0.1:5432/payment?schema=public"
SHADOW_DATABASE_URL="postgresql://payment_service:change-me@127.0.0.1:5432/payment_shadow?schema=public"

# RabbitMQ (RABBITMQ_USER / RABBITMQ_PASSWORD da raiz)
RABBITMQ_URL="amqp://comprefacil:change-me@127.0.0.1:5672"
# Fila que o serviço de notificação consome
NOTIFICATIONS_QUEUE=notifications
# Fila interna de processamento do pagamento
PAYMENT_PROCESSING_QUEUE=payment-processing
# Tempo simulado de processamento antes de confirmar (ms)
PAYMENT_PROCESSING_DELAY_MS=5000
# Reconciliação das transações PENDING (reenvio das mensagens)
RECONCILIATION_INTERVAL_MS=30000
RECONCILIATION_AFTER_MS=30000
