# Copie para .env e use as senhas do .env da raiz do repositório.
# Use 127.0.0.1 (e não localhost): o docker-compose só expõe as portas em IPv4.

# Porta HTTP do serviço
PORT=3001

# Banco da notificação (usuário NOTIFICATION_DB_USER / NOTIFICATION_DB_PASSWORD da raiz)
DATABASE_URL="postgresql://notification_service:change-me@127.0.0.1:5432/notification?schema=public"
SHADOW_DATABASE_URL="postgresql://notification_service:change-me@127.0.0.1:5432/notification_shadow?schema=public"

# RabbitMQ (RABBITMQ_USER / RABBITMQ_PASSWORD da raiz)
RABBITMQ_URL="amqp://comprefacil:change-me@127.0.0.1:5672"
# Fila consumida por este serviço (a mesma em que o Pagamento publica)
NOTIFICATIONS_QUEUE=notifications
