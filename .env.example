# Copie este arquivo para .env e troque os valores "change-me".
# O .env não vai para o git.
#
# Atenção às senhas:
# - use só letras, números, "-" e "_": elas vão entrar em URLs de conexão
#   dos serviços, onde @ : / # ? precisariam ser codificados;
# - não use "$" (o docker compose tenta interpretar como variável).
# - mudar nomes ou senhas do Postgres depois da primeira subida NÃO tem efeito:
#   o script de criação dos bancos roda uma vez só (ver README).

# Administrador do Postgres (usado pelo script de init e pelo pgAdmin).
# O servidor cadastrado no pgAdmin (docker/pgadmin/servers.json) usa o usuário "postgres".
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me

# Banco do serviço de pagamento (cria também o banco payment_shadow)
PAYMENT_DB_NAME=payment
PAYMENT_DB_USER=payment_service
PAYMENT_DB_PASSWORD=change-me

# Banco do serviço de notificação (cria também o banco notification_shadow)
NOTIFICATION_DB_NAME=notification
NOTIFICATION_DB_USER=notification_service
NOTIFICATION_DB_PASSWORD=change-me

# RabbitMQ (usuário do painel e dos serviços)
RABBITMQ_USER=comprefacil
RABBITMQ_PASSWORD=change-me

# pgAdmin (login do painel web)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
